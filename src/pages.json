{
  "pages": [
    // pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/index/index",
      "style": {
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/user/index",
      "style": {
        "navigationBarTitleText": "我的",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/shopping-car/index",
      "style": {
        "navigationBarTitleText": "购物车",
        "enablePullDownRefresh": false
      },
      "meta": {
        "requiresAuth": true
      }
    }
  ],
  "subPackages": [
    {
      "root": "subpackages/user",
      "pages": [
        {
          "path": "pages/login/index",
          "style": {
            "navigationBarTitleText": "登录",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/info/index",
          "style": {
            "navigationBarTitleText": "用户信息",
            "enablePullDownRefresh": false
          },
          "meta": {
            "requiresAuth": true
          }
        },
        {
          "path": "pages/feedback-test/index",
          "style": {
            "navigationBarTitleText": "反馈组件测试",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/container-test/index",
          "style": {
            "navigationBarTitleText": "Container 测试",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/container-test/default/index",
          "style": {
            "navigationBarTitleText": "Container-默认模式",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/container-test/fixed-footer/index",
          "style": {
            "navigationBarTitleText": "Container-固定高度+footer",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/container-test/fixed-overflow/index",
          "style": {
            "navigationBarTitleText": "Container-溢出滚动",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/container-test/header-bg/index",
          "style": {
            "navigationBarTitleText": "Container-header+背景图",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/container-test/classes-styles/index",
          "style": {
            "navigationBarTitleText": "Container-类名样式透传",
            "enablePullDownRefresh": false
          }
        }
      ]
    }
  ],
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "backgroundColor": "#fff",
    "color": "#999",
    "selectedColor": "#333",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/images/tab-bar-icon-home.png",
        "selectedIconPath": "static/images/tab-bar-icon-home-active.png"
      },
      {
        "pagePath": "pages/shopping-car/index",
        "text": "购物车",
        "iconPath": "static/images/tab-bar-icon-shopping-car.png",
        "selectedIconPath": "static/images/tab-bar-icon-shopping-car-active.png"
      },
      {
        "pagePath": "pages/user/index",
        "text": "我的",
        "iconPath": "static/images/tab-bar-icon-user.png",
        "selectedIconPath": "static/images/tab-bar-icon-user-active.png"
      }
    ]
  }
}
